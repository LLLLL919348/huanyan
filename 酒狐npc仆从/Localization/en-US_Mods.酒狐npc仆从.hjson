NPCs: {
	酒狐: {
		DisplayName: 酒狐

		TownNPCMood: {
			Content: 我很满足。
			NoHome: 我讨厌没有家。
			FarFromHome: 我离家太远了。
			LoveSpace: 我非常喜欢有这么大的空间。
			DislikeCrowded: 我不喜欢这么拥挤。
			HateCrowded: 我讨厌这么拥挤。
			LikeNPC_Princess: 我喜欢 {NPCName}。
			Princess_LovesNPC: 我喜欢 {NPCName}。
		}
	}
}

Items: {
	酒狐魂符: {
		Tooltip:
			'''
			收纳/召唤酒狐的宝物
			左键使用：把酒狐召唤到指向位置
			左键再次收纳酒狐
			物品名会随“是否带有酒狐”变化
			'''
		DisplayName: 酒狐魂符
	}

	梦云水晶: {
		Tooltip:
			'''
			[c/8FD8FF:仅酒狐可佩戴]（玩家饰品栏无法装备）
			装备后酒狐背后浮现[c/8FD8FF:梦幻光环]
			酒狐/梦云水晶弹幕攻击附带目标[c/8FD8FF:5%最大生命]伤害，且[c/8FD8FF:无视目标防御]
			酒狐获得[c/8FD8FF:70%任意伤害减免]，单次伤害不超过最大生命[c/8FD8FF:5%]
			血量过低时[c/8FD8FF:强制锁血、免疫死亡]
			并周期性发射多种弹幕（环形/流星雨/扇射/电光）
			'''
		DisplayName: 梦云水晶
	}

	嗜血之心: {
		Tooltip:
			'''
			将造成伤害的[c/FF5252:5%]转化为自身生命值（吸血）
			玩家佩戴时恢复值[c/FF5252:减半]
			'''
		DisplayName: 嗜血之心
	}

	混沌之书: {
		Tooltip:
			'''
			每次攻击后的[c/FFB020:片刻]，将额外造成该攻击[c/FFB020:5%]的伤害
			追加伤害同样计入吸血类装备（如[c/FF5252:嗜血之心]）的回血
			[c/FFB020:玩家和酒狐皆可使用]
			'''
		DisplayName: 混沌之书
	}

	双心之链: {
		Tooltip:
			'''
			玩家与酒狐各承担[c/99CBE8:一半]任意一方所受的伤害
			由酒狐执行，酒狐必须存在
			[c/99CBE8:仅酒狐可佩戴]
			'''
		DisplayName: 双心之链
	}

	不死图腾: {
		Tooltip:
			'''
			生命归零/死亡时立即恢复[c/FFBE46:30%最大生命值]
			给予[c/FFBE46:1分钟抗火+免疫岩浆]、[c/FFBE46:20s生命恢复]、[c/FFBE46:30s铁皮]
			播放图腾动画与音效并喷发大量粒子，随后道具销毁
			[c/FFBE46:钓鱼匣子1%~10% · 野外箱子约5%]
			'''
		DisplayName: 不死图腾
	}

	绀珠之药: {
		Tooltip:
			'''
			仅[c/99CBE8:酒狐]可佩戴
			相当于不死图腾，但不播动画/音效、仅少量粒子
			共[c/99CBE8:可使用8次]（命名显示剩余次数）
			6个不死图腾在作坊合成 · 丛林宝箱1.5%
			用尽销毁；微光湖可转化为无限版
			'''
		DisplayName: 绀珠之药
	}

	绀珠之药无限: {
		Tooltip:
			'''
			仅[c/99CBE8:酒狐]可佩戴
			相当于不死图腾，[c/99CBE8:无限次]触发
			由[c/99CBE8:绀珠之药]在微光湖中转化而来
			'''
		DisplayName: 绀珠之药（无限~）
	}

	魂之书: {
		Tooltip:
			'''
			仅[c/96B0FF:酒狐]可佩戴
			酒狐受击时先判定伤害：
			大于最大生命[c/96B0FF:60%]→只承60%并立刻回[c/96B0FF:30%]
			大于[c/96B0FF:30%]→立刻回[c/96B0FF:20%]再承伤
			否则直接[c/96B0FF:降低20%]再承伤
			并提高酒狐[c/96B0FF:100%无敌帧]
			蘑菇矿锭x10+灵质x5+魔法书x1+不死图腾x1在墓地合成
			'''
		DisplayName: 魂之书
	}

	芳心织囊: {
		Tooltip:
			'''
			玩家：正面buff时间[c/FF96BE:翻倍]、恢复药剂[c/FF96BE:+50%]、负面buff[c/FF96BE:减半]
			酒狐：恢复(药剂/自然回血/吸血)[c/FF96BE:翻倍]、喂食好感[c/FF96BE:额外+1]
			丝绸x20+奇异植物x1+羽毛x2在织布机合成
			'''
		DisplayName: 芳心织囊
	}

	樱眷发簪: {
		Tooltip:
			'''
			仅[c/FFAAC8:酒狐]可佩戴（优先级最高）
			来袭伤害减免[c/FFAAC8:20%]，每级好感度+20%（最高[c/FFAAC8:60%]）
			持续给予抗火/免疫中毒/生命恢复/铁皮/免疫岩浆等
			樱花树苗+芳心织囊+不死图腾+神圣锭x5在工匠作坊合成
			'''
		DisplayName: 樱眷发簪
	}

	低吟之戒: {
		Tooltip:
			'''
			酒狐攻击频率[c/96E096:加快20%]、所有伤害[c/96E096:+20%]
			击败名字带[c/96E096:法师]的生物1%掉落 · 地牢宝箱5%
			'''
		DisplayName: 低吟之戒
	}

	救赎之戒: {
		Tooltip:
			'''
			酒狐：最大生命[c/FFBE5A:+50%]、持续生命恢复
			玩家：受到任意来源伤害降为[c/FFBE5A:75%]、造成伤害[c/FFBE5A:+20%]、持续生命恢复
			神圣锭x10+力量之魂x5+视域之魂x5+恐惧之魂x5在秘银砧/山铜砧合成
			'''
		DisplayName: 救赎之戒
	}

	超级元素史莱姆: {
		Tooltip:
			'''
			攻击附带[c/96C86A:流血/中毒/着火/剧毒/诅咒焰/灵液/霜冻]
			玩家与酒狐均可佩戴
			尖刺x1+剧毒法杖x1+火山x1+毒液法杖x1+诅咒焰x1+黄金雨x1+结霜魔棒x1+凝胶x100在恶魔祭坛合成
			'''
		DisplayName: 超级元素史莱姆
	}

	磐石水晶: {
		Tooltip:
			'''
			获得[c/78C8FF:高额抗击退]，所受[c/78C8FF:弹幕伤害-5%]
			玩家与酒狐均可佩戴
			任意宝石x8+钴盾牌x1在工匠作坊合成
			击败圣骑士或任意名字带[c/78C8FF:巨人]（非boss）的怪物[c/78C8FF:3%]掉落
			'''
		DisplayName: 磐石水晶
	}

	法术强化核心: {
		Tooltip:
			'''
			法术伤害[c/C86EFF:+50%]、魔力值[c/C86EFF:+200]、魔法恢复[c/C86EFF:+50%]
			每[c/C86EFF:30秒]获得一层可[c/C86EFF:免疫一次伤害]的护盾（最多[c/C86EFF:2]层）
			护盾为环绕自身的[c/C86EFF:紫色流光]，两层时[c/C86EFF:反向旋转]
			攻击时额外召唤魔法箭弹幕（伤害[c/C86EFF:+200]）
			玩家与酒狐均可佩戴
			眼球激光塔x1+巫师帽x1+水晶球x1+毁灭者徽章x1+利刃台风x1+任意大宝石x1在远古操纵机合成
			'''
		DisplayName: 法术强化核心
	}

	法术超限: {
		DisplayName: 法术超限
		Tooltip: ""
	}

	寻风之铃: {
		Tooltip:
			'''
			复活已故酒狐的[c/9CDC48:铃铛]
