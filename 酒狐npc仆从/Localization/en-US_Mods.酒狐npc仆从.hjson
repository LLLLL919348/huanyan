			首次进入世界赠送
			'''
	}

	流转之心: {
		DisplayName: 流转之心
		Tooltip:
			'''
			所有恢复效力[c/96D8FF:+20%]（含吸血）
			最大生命[c/96D8FF:+10%]、防御力[c/96D8FF:+5%]
			加速自然生命恢复与魔法恢复
			[c/96D8FF:玩家与酒狐均可佩戴]
			光明之魂x10+黑暗之魂x10+天界石x1在工匠作坊合成
			'''
	}

	烬华之戒: {
		DisplayName: 烬华之戒
		Tooltip:
			'''
			每降低[c/FFAA5A:2%最大生命]，攻击力[c/FFAA5A:+0.5%]
			玩家：[c/FFAA5A:+5防御力]、受击后短暂无敌
			酒狐：[c/FFAA5A:+15防御力]
			[c/FFAA5A:玩家与酒狐均可佩戴]
			红宝石x1+银锭x3+灰烬块x10在工作台合成 · 克苏鲁之眼5%掉落
			'''
	}

	紫荆冠刺: {
		DisplayName: 紫荆冠刺
		Tooltip:
			'''
			攻击使目标防御力暂时降低[c/BE8CFF:目标最大防御25%+20点]
			受到的伤害[c/BE8CFF:全额返还]给伤害者
			防御力[c/BE8CFF:+15]、受到的近战伤害[c/BE8CFF:-20%]
			[c/BE8CFF:玩家与酒狐均可佩戴]
			尖刺x10+银锭x3+紫水晶x1+灵液x3在工匠作坊合成 · 尖刺史莱姆5%掉落
			'''
